# Non-secret defaults (committed). Secrets live in .env.local (pulled with `vercel env pull`).
# Vercel AI Gateway free tier: only Gemini models, 5 requests/minute.
# After adding AI Gateway credits, switch to Claude (better on school PDFs) and remove AI_RPM:
#   AI_PAGE_MODEL=anthropic/claude-haiku-5.5
#   AI_PDF_MODEL=anthropic/claude-sonnet-5.5
AI_PAGE_MODEL=google/gemini-2.5-flash
AI_PDF_MODEL=google/gemini-2.5-flash
AI_RPM=5
